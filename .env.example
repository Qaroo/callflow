# AIServant (Yoav's call server). All three stay on the local server and never reach the browser.
YOAVHAIK_API_BASE_URL=https://yoavhaik.com:7025
DEMO_LEADS_OWNER_UID=<agency uid>     # the account (X-Agency-Id, and makecall apiKey). Can be changed in Settings
AISERVANT_SHARED_SECRET=              # sent as X-Api-Key

# Voice library (#/voices): where starter/reaction tables and clips live.
#   aiservant = AIServant's /SpeechClips API     local = a stand-in under data/speech/ with the same rules
SPEECH_CLIPS_BACKEND=local

# Cartesia, to generate clips in the voice library (8 kHz μ-law WAV + word timestamps). Optional.
CARTESIA_API_KEY=
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VERSION=2026-08-14

# Where the local server keeps its files (default ./data)
# CALLFLOW_DATA_DIR=data
